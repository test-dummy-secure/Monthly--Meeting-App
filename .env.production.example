# ============================================================
# BMMJ Production Environment Variables
# ============================================================
# Copy this file to .env.production and fill in real values.
# NEVER commit .env.production to git.
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── Database (PostgreSQL) ────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=bmmj_db
DB_USER=postgres
DB_PASSWORD=replace_with_strong_password

# ── Cache / Queue (Redis / Memurai) ─────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── JWT Auth ─────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_byte_hex_secret
JWT_ACCESS_SECRET=replace_with_64_byte_hex_secret_access
JWT_REFRESH_SECRET=replace_with_64_byte_hex_secret_refresh

# ── NXG360 Integration ───────────────────────────────────────
# Base URL of the NXG360 MSSP API (no trailing slash)
NXG360_API_BASE_URL=https://api.nxg360.com

# AES-256-GCM encryption key for storing NXG360 API credentials at rest.
# Must be exactly 64 hex characters (32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NXG360_ENCRYPTION_KEY=replace_with_64_char_hex_key

# ── Token Encryption ─────────────────────────────────────────
# AES-256-GCM key for encrypting Microsoft OAuth tokens at rest.
# REQUIRED in production — validateConfig() throws at startup without it.
# Must be exactly 64 hex characters (32 bytes).
TOKEN_ENCRYPTION_KEY=replace_with_64_char_hex_key

# ── Ollama AI Engine ─────────────────────────────────────────
# Ollama runs on the HOST machine, outside Docker.
# host.docker.internal resolves to the host from inside a container —
# requires the extra_hosts entry in docker-compose.yml.
# If Ollama runs on a separate server, replace with that server's IP/hostname.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# qwen2.5:14b (~9GB) — larger extraction capacity than llama3.1 8B while still
# CPU-viable. Only use llama3.3:70b or similar if the VM has a GPU with enough
# VRAM (~40GB+) and Ollama is confirmed to be using it — on CPU a 70B model
# needs ~40-45GB RAM just to load and is too slow to finish inside any
# reasonable timeout, causing every segment to time out and the pipeline to
# return an empty "no items extracted" result even though nothing in the
# extraction logic itself is broken.
OLLAMA_MODEL=qwen2.5:14b
# Ollama's own server drops idle connections at ~5 min regardless of this
# value — keep maxTokens low in noteStructurer.service.js rather than
# raising this to compensate.
OLLAMA_TIMEOUT=900000
OLLAMA_NUM_CTX=8192
# llama3.1 8B — the proven, tested model. Used if the primary model is
# unavailable or times out repeatedly, so a bad primary run still recovers.
OLLAMA_FALLBACK_MODEL=llama3.1
# Max simultaneous AI analyses — keep at 1 for CPU-only inference; concurrent
# requests get rejected by Ollama (503 busy) rather than queued.
AI_CONCURRENCY=1
AI_MAX_ITEMS_PER_RUN=20

# ── Email / SMTP (Phase 9 — fallback path) ────────────────────
# REQUIRED in production — validateConfig() throws at startup without
# SMTP_USER, SMTP_PASS, and SMTP_FROM. This is the FALLBACK send path —
# email.service.js tries Microsoft Graph first (see MS_* below) and only
# falls back to SMTP if Graph isn't configured or a send fails. Fill this in
# regardless; Graph needs a one-time Azure AD admin-consent step that may not
# be done yet.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=Your App Name <your_smtp_username>

# ── Microsoft 365 OAuth2 (Phase 11 — live) ────────────────────
# REQUIRED in production — validateConfig() throws at startup without
# MS_CLIENT_ID. Register the app at portal.azure.com → Azure Active
# Directory → App registrations. Required API permissions:
# Calendars.Read, OnlineMeetings.Read, User.Read, offline_access (delegated,
# for calendar/Teams) — PLUS Mail.Send (Application permission, with admin
# consent) if you want Graph to send system notification emails instead of
# SMTP; see MicrosoftAppAuthClient.js for exactly where to grant that.
# MS_REDIRECT_URI must point at your production domain, not localhost —
# it must also be registered as a redirect URI in the Azure app.
MS_CLIENT_ID=your_microsoft_app_client_id_guid
MS_CLIENT_SECRET=your_microsoft_app_secret_value
MS_REDIRECT_URI=https://yourdomain.com/api/integrations/microsoft/callback
# Azure Portal → Azure Active Directory → Overview → Directory (tenant) ID.
# Required for both the delegated OAuth flow and the Graph mail sender —
# without it both fall back to the multi-tenant /organizations endpoint.
MS_TENANT_ID=your_azure_ad_tenant_id_guid
# Mailbox Graph sends system notification emails as. Defaults to SMTP_USER
# above if unset.
# MS_MAIL_SENDER=notifications@yourdomain.com

# ── Super Admin Bootstrap ──────────────────────────────────────
# REQUIRED in production — validateConfig() throws at startup without them.
# This is the ONLY admin account auto-created on a fresh database — there
# is no hardcoded fallback in production. Use a real, unique password here
# (8+ chars, not a common default) and change it after first login.
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=replace_with_a_strong_unique_password

# ── Google OAuth2 (not yet implemented) ───────────────────────
# No route or validate.js check currently reads these — leave commented
# until this integration is actually built.
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/google/callback
