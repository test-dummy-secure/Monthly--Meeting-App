# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=bmmj_user
DB_PASSWORD=your_secure_password_here
DB_NAME=BMMJ
# Log queries slower than this (ms). Default: 500
# DB_SLOW_QUERY_MS=500

# ── JWT ───────────────────────────────────────────────────────────────────────
# All three are required. Use long random strings (min 32 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
JWT_ACCESS_SECRET=your_access_token_secret_here
JWT_REFRESH_SECRET=your_refresh_token_secret_here

# ── Redis (BullMQ jobs + findings cache) ─────────────────────────────────────
# Windows: use Memurai (https://www.memurai.com/)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── NXG360 Integration ────────────────────────────────────────────────────────
NXG360_API_BASE_URL=https://nxg360.nxgsecure.com/api
# MUST be exactly 64 hex characters (32 bytes for AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NXG360_ENCRYPTION_KEY=your_64_hex_char_key_here

# ── Ollama AI Engine ──────────────────────────────────────────────────────────
# Install: https://ollama.ai  |  Pull model: ollama pull llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Optional: fallback model if primary times out
OLLAMA_FALLBACK_MODEL=
# Request timeout in milliseconds (default: 120000 = 2 min)
OLLAMA_TIMEOUT=120000
# Max prompt characters before findings/tasks are trimmed (1 token ≈ 4 chars)
AI_MAX_PROMPT_CHARS=24000

# ── Email / SMTP (Phase 9 — not yet implemented) ──────────────────────────────
# SMTP_HOST=smtp.yourmailprovider.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# SMTP_FROM=noreply@nxgsecure.com

# ── Microsoft OAuth2 / Graph API (Phase 11) ──────────────────────────────────
# Register an app at https://portal.azure.com → Azure Active Directory → App registrations
# Add redirect URI: http://localhost:5000/api/integrations/microsoft/callback (dev)
#                   https://yourdomain.com/api/integrations/microsoft/callback  (prod)
# Required API permissions: Calendars.Read, OnlineMeetings.Read, User.Read, offline_access
MS_CLIENT_ID=your_azure_app_client_id_guid
MS_CLIENT_SECRET=your_azure_client_secret_value
MS_REDIRECT_URI=http://localhost:5000/api/integrations/microsoft/callback

# AES-256-GCM key for encrypting OAuth tokens at rest (must be exactly 64 hex chars / 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=replace_with_64_hex_chars_generated_by_command_above

# ── Calendly Integration ──────────────────────────────────────────────────────
# Signing key for verifying Calendly webhook POST requests (HMAC-SHA256).
# Get it from: Calendly → Integrations → API & Webhooks → Webhook Subscriptions
# → (create/open subscription) → copy the Signing Key shown on the page.
# If not set, signature verification is SKIPPED (dev/local only — always set in production).
CALENDLY_WEBHOOK_SIGNING_KEY=

# Optional: platform-level Calendly Personal Access Token fallback.
# Used by the /api/calendar/calendly/sync endpoint when an AM has not yet saved
# their own token via the BMMJ UI.  Generate at:
# Calendly → Integrations → API & Webhooks → Personal Access Tokens → Generate new token
# Leave blank if each AM will enter their token in the BMMJ "Send Booking Link" modal.
CALENDLY_API_TOKEN=
