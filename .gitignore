# ── Environment / Secrets ────────────────────────────────────
.env
.env.production
.env.local
.env.*.local
# Keep the example template committed
!.env.production.example
# Generated fresh per CI run (backend/.github/workflows/dast-checks.yml) -
# carries a live JWT, never meant to be committed. Backup safety net only,
# the workflow never stages or commits it either.
zap-auth.conf
zap-report.xml

# ── Dependencies ─────────────────────────────────────────────
node_modules/
backend/node_modules/
frontend/node_modules/

# ── Build outputs ────────────────────────────────────────────
frontend/dist/
backend/dist/

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/
backend/logs/

# ── OS / Editor ──────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/settings.json
*.swp
*.swo

# ── Docker volumes (local dev data) ─────────────────────────
postgres_data/
redis_data/

# ── Local reference docs (downloaded artifacts, not source) ──
docs/platform-reference/
